{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Word Overlay",
  "version": "0.1.0",
  "identifier": "com.vlad.wordoverlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Word Overlay",
        "width": 380,
        "height": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": true,
        "noRedirectionBitmap": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Word Overlay — Settings",
        "width": 560,
        "height": 680,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
